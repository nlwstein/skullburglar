#!/bin/sh
# AppImage entry point. The game is the same build as the tarball, laid out flat in the AppImage.
# The AppImage is mounted read-only and the game logs next to its executable by default, so logs go to the
# per-user state directory instead (a --log_file given on the command line still wins).
# One log per launch, bots-<yyyymmdd-HHMMSS>.log, newest 10 kept (the macOS app does the same). A single shared file
# made every launch append to it, so a crash archive (crashes/<stamp>/) copied every earlier session along with the
# one that crashed, and a bug report's "newest log" held several sessions.
HERE=$(dirname "$(readlink -f "$0")")
LOGS=${XDG_STATE_HOME:-$HOME/.local/state}/bots-recomp/logs
mkdir -p "$LOGS"
# Names sort by time; the one about to be made is the 10th. Only our own bots-*.log names are touched.
ls -1 "$LOGS"/bots-*.log 2>/dev/null | sort | awk -v keep=9 '{ a[NR] = $0 } END { for (i = 1; i <= NR - keep; i++) print a[i] }' |
  while IFS= read -r old; do rm -f -- "$old"; done
exec "$HERE/bots" --log_file="$LOGS/bots-$(date +%Y%m%d-%H%M%S).log" "$@"
