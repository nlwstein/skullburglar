# Cross-compile to x86_64 Windows (MSVC ABI) from Linux: clang GNU driver + lld-link + xwin CRT/SDK.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(XWIN /w/xwin)
set(triple x86_64-pc-windows-msvc)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET ${triple})
set(CMAKE_CXX_COMPILER_TARGET ${triple})
set(CMAKE_RC_COMPILER llvm-rc)
set(CMAKE_MT llvm-mt)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_LINKER_TYPE LLD)
set(_inc "-march=x86-64-v2 -idirafter ${XWIN}/crt/include -idirafter ${XWIN}/sdk/include/ucrt -idirafter ${XWIN}/sdk/include/um -idirafter ${XWIN}/sdk/include/shared -idirafter ${XWIN}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${_inc}")
set(CMAKE_CXX_FLAGS_INIT "${_inc}")
set(CMAKE_RC_FLAGS_INIT "-I ${XWIN}/sdk/include/um -I ${XWIN}/sdk/include/shared")
set(_lib "-fuse-ld=lld -L${XWIN}/crt/lib/x86_64 -L${XWIN}/sdk/lib/um/x86_64 -L${XWIN}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_FIND_ROOT_PATH ${XWIN})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
