# Input parity test for the launcher menu (tools/launcher_preview.sh ... --sizes 1920x1080 --script @tests/launcher_input.script).
# Every edit is done once with the keyboard, once with a controller and, where a click or drag does it, with the mouse.
# Keyboard: main menu -> Graphics, toggle, default, choice, slider steps
key:Down
key:Enter
expect-page:graphics
key:Enter
expect:fullscreen=false
key:Delete
expect:fullscreen=true
key:Down
key:Right
expect:renderer=pre1
key:Left
expect:renderer=new
key:Down
key:Down
key:Down
key:Down
key:Right
expect:fov_offset=1
key:Shift+Right
expect:fov_offset=6
key:Tab
key:Shift+Tab
key:Left
expect:fov_offset=5
key:E
expect-page:hdr
key:Q
expect-page:graphics
key:Escape
expect-page:main
# Controller: sections, toggle, default, trigger steps, back
pad:RB
expect-page:graphics
pad:RB
expect-page:hdr
pad:A
expect:vulkan_hdr=true
pad:Y
expect:vulkan_hdr=false
pad:Down
pad:RT
expect:vulkan_hdr_paper_white=250
pad:LT
expect:vulkan_hdr_paper_white=200
pad:Right
expect:vulkan_hdr_paper_white=210
pad:LB
expect-page:graphics
pad:B
expect-page:main
# Mouse: click a toggle, drag a slider to its end, wheel
page:game
click:0.3,0.22
expect:intro_movies=true
drag:0.45,0.525,0.95,0.525
expect:movie_volume=200
wheel:-3
# Key bindings: Set, Add, Default, cancel three ways, Escape as a key
page:bindings
focus:kbm_move_forward
key:Enter
key:K
expect:kbm_move_forward=K
key:Insert
key:Up
expect:kbm_move_forward=K,Up
key:Delete
expect:kbm_move_forward=W
pad:A
pad:B
expect:kbm_move_forward=W
key:Enter
hold:Escape:1
expect:kbm_move_forward=W
key:Enter
key:Escape
expect:kbm_move_forward=Escape
pad:Y
expect:kbm_move_forward=W
pad:X
key:G
expect:kbm_move_forward=W,G
# Play from a page: controller Start and Ctrl+Enter
page:coop
pad:Start
expect-action:play
key:Ctrl+Enter
expect-action:play
# The update switch (development builds of the game don't have it)
focus:check_updates
expect-page:updates
key:Enter
expect:check_updates=false
# Reset to defaults: confirm with the keyboard (it keeps the update switch)
page:about
reset-confirm
key:Left
key:Enter
expect-action:reset
expect:kbm_move_forward=W
expect:intro_movies=false
expect:check_updates=false
