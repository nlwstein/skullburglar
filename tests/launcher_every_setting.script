# Changes every launcher setting once, alternating keyboard and controller (tests/launcher_every_setting.script).
# Run in the game with BOTS_SETUP_SHOT_SAVE=1 and check that bots.toml then holds every key; generated from
# src/setup/settings_catalog.cpp (every setting, Pause background blur included), except check_updates (development builds don't have it; tests/launcher_input.script
# covers the same kind of switch).
shot:before
focus:fullscreen
key:Enter
focus:intro_movies
pad:A
focus:achievement_popups
key:Enter
# Anti-aliasing and sharpening are new-renderer settings: changed before the renderer switches to the pre-1.0 one.
focus:anti_aliasing
key:Enter
focus:sharpening
pad:Right
focus:ambient_occlusion
key:Enter
focus:ambient_occlusion_strength
pad:Right
focus:pause_blur
key:Enter
focus:renderer
pad:A
# The pre-1.0 occlusion setting only works with the pre-1.0 renderer, chosen just above.
focus:pre1_occlusion
key:Enter
focus:render_scale
key:Enter
focus:aspect_ratio
pad:A
focus:fov_offset
key:Right
focus:vulkan_hdr
pad:A
focus:vulkan_hdr_paper_white
key:Right
focus:vulkan_hdr_peak
pad:Right
focus:vulkan_hdr_ui_white
key:Right
focus:vulkan_hdr_exposure
