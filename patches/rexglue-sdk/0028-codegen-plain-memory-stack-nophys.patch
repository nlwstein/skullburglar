@@ -487,6 +487,17 @@ void BuilderContext::emit_vec_var_shift(const char* shift_dir, const char* eleme
 // Memory (Load/Store) Code Generation Helpers
 //=============================================================================
 
+namespace {
+/// r1 (the stack pointer) never points into the physical-mirror range, so r1-relative accesses use
+/// REX_SLOAD_* / REX_SSTORE_*, which the PCH may define without the physical-offset select.
+const char* stack_macro(const char* macro, bool is_stack, char* buf, size_t n) {
+  if (!is_stack) return macro;
+  if (strncmp(macro, "REX_LOAD_", 9) == 0) { snprintf(buf, n, "REX_SLOAD_%s", macro + 9); return buf; }
+  if (strncmp(macro, "REX_STORE_", 10) == 0) { snprintf(buf, n, "REX_SSTORE_%s", macro + 10); return buf; }
+  return macro;
+}
+}  // namespace
