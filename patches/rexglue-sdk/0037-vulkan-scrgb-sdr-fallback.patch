+namespace {
+// HDR requested: whether the guest output is FP16, fixed once per run. 0: not decided yet, 1: FP16 (scRGB),
+// 2: kGuestOutputFormat (no scRGB surface: exactly the HDR-off path).
+std::atomic<int> guest_output_hdr_state{0};
+
+// BOTS_TEST_NO_SCRGB=1: treat every surface as offering no scRGB (tests the SDR fallback on an HDR-capable surface).
+bool TestNoScrgb() {
+  static const bool no_scrgb = [] {
+    const char* v = std::getenv("BOTS_TEST_NO_SCRGB");
+    return v && *v == '1';
+  }();
+  return no_scrgb;
+}
+}  // namespace
+
+bool VulkanPresenter::HdrRequested() {
+  // Read once (restart required): the presenter's objects are created for it.
+  static const bool requested = REXCVAR_GET(vulkan_hdr);
+  return requested;
+}
+
 VkFormat VulkanPresenter::GuestOutputFormat() {
-  // Keep the guest output format fixed until restart.
-  static const VkFormat format = REXCVAR_GET(vulkan_hdr) ? VK_FORMAT_R16G16B16A16_SFLOAT : kGuestOutputFormat;
-  return format;
+  if (!HdrRequested()) return kGuestOutputFormat;
+  int state = guest_output_hdr_state.load(std::memory_order_acquire);
+  if (state == 0) {
+    // Asked before the first swapchain (normally the window connects first): keep FP16 for this run.
+    if (guest_output_hdr_state.compare_exchange_strong(state, 1, std::memory_order_acq_rel)) {
+      REXLOG_WARN("VulkanPresenter: HDR output fixed to FP16 before the first swapchain; on a display without scRGB "
+                  "the run keeps the FP16 path");
+      state = 1;
+    }
+  }
+  return state == 1 ? VK_FORMAT_R16G16B16A16_SFLOAT : kGuestOutputFormat;
 }
 
