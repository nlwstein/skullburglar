     const VkDebugUtilsMessengerCallbackDataEXT* callback_data, [[maybe_unused]] void* user_data) {
+  // Below error severity, log each distinct message text only at counts 1, 10, 100, ... - MoltenVK
+  // repeats some warnings on every pipeline use (e.g. "Metal does not support disabling primitive
+  // restart", ~40/s in UE3 gameplay), which floods and rotates the log.
+  uint64_t repeat_count = 1;
+  if (message_severity < VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT && callback_data->pMessage) {
+    static std::mutex repeat_mutex;
+    static std::unordered_map<std::string, uint64_t> repeat_counts;
+    std::lock_guard<std::mutex> lock(repeat_mutex);
+    repeat_count = ++repeat_counts[callback_data->pMessage];
+    uint64_t power = 1;
+    while (power < repeat_count) {
+      power *= 10;
+    }
+    if (power != repeat_count) {
+      return VK_FALSE;
+    }
+  }
+
   std::ostringstream log_str;
+  if (repeat_count > 1) {
+    log_str << "[repeated " << repeat_count << "x] ";
+  }
 
   log_str << "Vulkan " << vk::to_string(vk::DebugUtilsMessageSeverityFlagBitsEXT(message_severity))
           << " (" << vk::to_string(vk::DebugUtilsMessageTypeFlagsEXT(message_types)) << ", ID "
