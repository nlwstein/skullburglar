+// Underrun statistics, logged every 10 s once audio has started: frames the device played, silent fills (5.3 ms each)
+// because the guest had not delivered the next frame, how many separate underruns those fills formed, the lowest queue
+// depth a callback found, and the longest gap between two guest frames.
+struct AudioStats {
+  std::atomic<uint64_t> played{0}, silent{0}, underruns{0};
+  std::atomic<int64_t> min_queue{1 << 30}, max_gap_us{0}, last_submit_us{0};
+  bool started = false, starving = false;
+  std::chrono::steady_clock::time_point next_log{};
+};
+AudioStats g_audio_stats;
+int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+void LogAudioStats() {
+  auto& st = g_audio_stats;
+  const auto now = std::chrono::steady_clock::now();
+  if (now < st.next_log) return;
+  if (st.next_log != std::chrono::steady_clock::time_point{}) {
+    const int64_t mq = st.min_queue.exchange(1 << 30);
+    REXAPU_INFO("audio: {} frames played, {} silent fills in {} underruns, queue min {}, longest guest frame gap {:.1f} ms",
+                st.played.exchange(0), st.silent.exchange(0), st.underruns.exchange(0), mq == (1 << 30) ? -1 : mq,
+                st.max_gap_us.exchange(0) / 1000.0);
+  }
+  st.next_log = now + std::chrono::seconds(10);
+}
+}  // namespace
