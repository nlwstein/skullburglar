diff --git a/src/ui/shaders/guest_output_scrgb.frag b/src/ui/shaders/guest_output_scrgb.frag
new file mode 100644
--- /dev/null
+++ b/src/ui/shaders/guest_output_scrgb.frag
@@ -0,0 +1,23 @@
+#version 450
+// glslangValidator -V -Os --vn guest_output_scrgb_ps guest_output_scrgb.frag -o vulkan_spirv/guest_output_scrgb_ps.h
+layout(constant_id = 0) const bool scrgb = true;
+layout(set = 0, binding = 0) uniform texture2D source;
+layout(set = 0, binding = 1) uniform sampler smp;
+layout(push_constant) uniform Constants {
+  layout(offset = 16) ivec2 output_offset;
+  vec2 output_size_inv;
+  float ui_white;
+};
+layout(location = 0) out vec4 result;
+void main() {
+  vec2 uv = (gl_FragCoord.xy - vec2(output_offset)) * output_size_inv;
+  vec3 c = textureLod(sampler2D(source, smp), uv, 0.0).rgb;
+  if (!scrgb) {
+    c = max(c / ui_white, 0.0);
+    float m = max(max(c.r, c.g), c.b);
+    // UI white used as SDR white then highlights scaled to fit.
+    if (m > 1.0) c /= m;
+    c = pow(c, vec3(1.0 / 2.2));
+  }
+  result = vec4(c, 1.0);
+}
diff --git a/src/ui/shaders/immediate_scrgb.frag b/src/ui/shaders/immediate_scrgb.frag
new file mode 100644
--- /dev/null
+++ b/src/ui/shaders/immediate_scrgb.frag
@@ -0,0 +1,13 @@
+#version 450
+// glslangValidator -V -Os --vn immediate_scrgb_ps immediate_scrgb.frag -o vulkan_spirv/immediate_scrgb_ps.h
+layout(push_constant) uniform Constants { layout(offset = 8) float ui_white; };
+layout(set = 0, binding = 0) uniform sampler2D source;
+layout(location = 0) in vec2 uv;
+layout(location = 1) in vec4 color;
+layout(location = 0) out vec4 result;
+void main() {
+  vec4 c = color * textureLod(source, uv, 0.0);
+  c.rgb = mix(pow((c.rgb + 0.055) / 1.055, vec3(2.4)), c.rgb / 12.92,
+              lessThanEqual(c.rgb, vec3(0.04045))) * ui_white;
+  result = c;
+}
