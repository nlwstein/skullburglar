diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..9f74ff3
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,185 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android backend for rex::thread::Fiber (experimental Android builds)
+ *
+ * Bionic declares ucontext_t but has no getcontext/makecontext/swapcontext, so this switches
+ * stacks directly: rex_fiber_switch pushes the callee-saved registers on the current stack,
+ * stores the stack pointer, loads the target's and pops its registers. A new fiber's stack is
+ * laid out as if it had been switched out just before rex_fiber_start, which calls the entry
+ * held in the first callee-saved register slot.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstring>
+
+extern "C" void rex_fiber_switch(void** save_sp, void* new_sp);
+extern "C" void rex_fiber_start();
+
+#if defined(__aarch64__)
+// Frame (176 bytes): x19-x28, x29, x30 (return address), d8-d15, 16 bytes of padding.
+__asm__(R"(
+  .text
+  .p2align 2
+  .globl rex_fiber_switch
+  .type rex_fiber_switch, %function
+rex_fiber_switch:
+  sub sp, sp, #176
+  stp x19, x20, [sp, #0]
+  stp x21, x22, [sp, #16]
+  stp x23, x24, [sp, #32]
+  stp x25, x26, [sp, #48]
+  stp x27, x28, [sp, #64]
+  stp x29, x30, [sp, #80]
+  stp d8, d9, [sp, #96]
+  stp d10, d11, [sp, #112]
+  stp d12, d13, [sp, #128]
+  stp d14, d15, [sp, #144]
+  mov x2, sp
+  str x2, [x0]
+  mov sp, x1
+  ldp x19, x20, [sp, #0]
+  ldp x21, x22, [sp, #16]
+  ldp x23, x24, [sp, #32]
+  ldp x25, x26, [sp, #48]
+  ldp x27, x28, [sp, #64]
+  ldp x29, x30, [sp, #80]
+  ldp d8, d9, [sp, #96]
+  ldp d10, d11, [sp, #112]
+  ldp d12, d13, [sp, #128]
+  ldp d14, d15, [sp, #144]
+  add sp, sp, #176
+  ret
+  .size rex_fiber_switch, .-rex_fiber_switch
+
+  .p2align 2
+  .globl rex_fiber_start
+  .type rex_fiber_start, %function
+rex_fiber_start:
+  blr x19
+  brk #0
+  .size rex_fiber_start, .-rex_fiber_start
+)");
+
+namespace {
+constexpr size_t kFrameSize = 176;
+constexpr size_t kEntrySlot = 0;       // x19
+constexpr size_t kReturnSlot = 88;     // x30
+}  // namespace
+
+#elif defined(__x86_64__)
+// Frame (64 bytes): MXCSR and x87 control word, r15, r14, r13, r12, rbx, rbp, return address.
+__asm__(R"(
+  .text
+  .p2align 4
+  .globl rex_fiber_switch
+  .type rex_fiber_switch, @function
+rex_fiber_switch:
+  pushq %rbp
+  pushq %rbx
+  pushq %r12
+  pushq %r13
+  pushq %r14
+  pushq %r15
+  subq $8, %rsp
+  stmxcsr (%rsp)
+  fnstcw 4(%rsp)
+  movq %rsp, (%rdi)
+  movq %rsi, %rsp
+  ldmxcsr (%rsp)
+  fldcw 4(%rsp)
+  addq $8, %rsp
+  popq %r15
+  popq %r14
+  popq %r13
+  popq %r12
+  popq %rbx
+  popq %rbp
+  ret
+  .size rex_fiber_switch, .-rex_fiber_switch
+
+  .p2align 4
+  .globl rex_fiber_start
+  .type rex_fiber_start, @function
+rex_fiber_start:
+  call *%rbx
+  ud2
+  .size rex_fiber_start, .-rex_fiber_start
+)");
+
+namespace {
+constexpr size_t kFrameSize = 64;
+constexpr size_t kEntrySlot = 40;   // rbx
+constexpr size_t kReturnSlot = 56;
+constexpr uint32_t kDefaultMxcsr = 0x1F80;
+constexpr uint16_t kDefaultFpuControl = 0x037F;
+}  // namespace
+
+#else
+#error "fiber_android.cpp: unsupported architecture"
+#endif
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  // The thread's own stack: sp_ is filled in by the first switch away from it.
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // Aligned top of the stack; at rex_fiber_start the stack pointer is this value.
+  auto top = (reinterpret_cast<uintptr_t>(f->stack_.data()) + f->stack_.size()) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint8_t*>(top - kFrameSize);
+  std::memset(frame, 0, kFrameSize);
+  void (*trampoline)() = &Fiber::Trampoline;
+  void (*start)() = &rex_fiber_start;
+  std::memcpy(frame + kEntrySlot, &trampoline, sizeof(trampoline));
+  std::memcpy(frame + kReturnSlot, &start, sizeof(start));
+#if defined(__x86_64__)
+  std::memcpy(frame, &kDefaultMxcsr, sizeof(kDefaultMxcsr));
+  std::memcpy(frame + 4, &kDefaultFpuControl, sizeof(kDefaultFpuControl));
+#endif
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the switch landed here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // Fiber entries never return (the guest switches away for good); there is nothing to return to.
+  assert(false && "fiber entry returned");
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID
