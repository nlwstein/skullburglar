+xam::UserProfile* KernelState::user_profile(uint32_t user_index) const {
+  if (user_index == 0) return user_profile_.get();
+  if (user_index >= 4 || !other_signed_in_[user_index - 1]) return nullptr;
+  return other_users_[user_index - 1].get();
+}
+
+void KernelState::SignInUser(uint32_t user_index, uint64_t xuid, const std::string& name,
+                             const std::filesystem::path& content_root) {
+  if (user_index == 0 || user_index >= 4) return;
+  auto& slot = other_users_[user_index - 1];
+  if (!slot || slot->xuid() != xuid || slot->name() != name.substr(0, 15)) {
+    if (other_signed_in_[user_index - 1]) SignOutUser(user_index);
+    if (!content_root.empty()) content_manager_->SetUserContentRoot(xuid, std::filesystem::absolute(content_root));
+    // A replaced profile is leaked on purpose: a guest call may still be using it.
+    (void)slot.release();
+    slot = std::make_unique<xam::UserProfile>(xuid, name);
+    slot->set_kernel_state(this);
+  }
+  other_signed_in_[user_index - 1] = true;
+  REXSYS_INFO("User {} signed in: {} ({:016X})", user_index, slot->name(), xuid);
+  BroadcastNotification(0x0000000A, SignedInMask());  // XN_SYS_SIGNINCHANGED: who is signed in now
+}
+
+uint32_t KernelState::SignedInMask() const {
+  uint32_t mask = 1;
+  for (uint32_t i = 0; i < 3; ++i) mask |= other_signed_in_[i] ? 2u << i : 0;
+  return mask;
+}
+
+void KernelState::SignOutUser(uint32_t user_index) {
+  if (user_index == 0 || user_index >= 4 || !other_signed_in_[user_index - 1]) return;
+  other_signed_in_[user_index - 1] = false;
+  REXSYS_INFO("User {} signed out", user_index);
+  BroadcastNotification(0x0000000A, SignedInMask());
+}
