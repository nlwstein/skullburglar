+// The XUID whose content a call for this user index sees: a signed-in local user's, else user 0's.
+static uint64_t ContentXuid(uint32_t user_index, const char* caller) {
+  auto* user = user_index < 4 ? REX_KERNEL_STATE()->user_profile(user_index) : nullptr;
+  if (user_index && user_index < 4) {  // what a title stores for other local users: the first call of each kind
+    static std::atomic<uint32_t> logged{0};
+    const uint32_t bit = 1u << (std::hash<std::string_view>{}(caller) % 32);
+    if (!(logged.fetch_or(bit) & bit)) {
+      REXKRNL_INFO("{}: user {} ({})", caller, user_index, user ? user->name() : "not signed in");
+    }
+  }
+  return (user ? user : REX_KERNEL_STATE()->user_profile())->xuid();
+}
