 class VulkanInstance {
  public:
+  // Some runtimes only accept a Vulkan instance they created themselves - OpenXR's Vulkan binding, for one,
+  // rejects any instance that did not come from xrCreateVulkanInstanceKHR. An app using one installs a callback
+  // here before Create(); it is then called instead of vkCreateInstance, and may add the extensions the runtime
+  // requires to `create_info` (which is only valid for the duration of the call) before creating the instance.
+  // Return the VkResult of the runtime's own creation, or create the instance with the loader.
+  using ExternalCreateCallback = std::function<VkResult(VkInstanceCreateInfo& create_info,
+                                                        const VkAllocationCallbacks* allocator,
+                                                        VkInstance* instance_out)>;
+  static void SetExternalCreateCallback(ExternalCreateCallback callback);
+
   static std::unique_ptr<VulkanInstance> Create(bool with_surface, bool try_enable_validation);
 
   VulkanInstance(const VulkanInstance&) = delete;
