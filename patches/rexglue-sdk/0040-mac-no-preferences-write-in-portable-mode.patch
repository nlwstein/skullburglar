 #include <cstring>
 #include <filesystem>
 
@@ -32,6 +33,8 @@
 #include <rex/ui/surface_win.h>
 #elif REX_PLATFORM_MAC
 #include <CoreFoundation/CoreFoundation.h>
+#include <objc/message.h>
+#include <objc/runtime.h>
 #include <SDL3/SDL_metal.h>
 
 #include <rex/ui/surface_mac.h>
@@ -195,9 +198,26 @@
     SDL_SetWindowFullscreen(sdl_window_, true);
   }
 #if REX_PLATFORM_MAC
-  CFPreferencesSetAppValue(CFSTR("ApplePressAndHoldEnabled"), kCFBooleanFalse,
-                           kCFPreferencesCurrentApplication);
-  CFPreferencesAppSynchronize(kCFPreferencesCurrentApplication);
+  if (const char* no_write = std::getenv("REX_NO_PREFS_WRITE"); no_write && no_write[0] == '1') {
+    // The app asked for nothing to be written outside its own folders (portable mode): the same setting for this
+    // process only, as if it had been started with "-ApplePressAndHoldEnabled NO" (NSArgumentDomain is in memory).
+    id defaults = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSUserDefaults"),
+                                                 sel_registerName("standardUserDefaults"));
+    id current = ((id(*)(id, SEL, id))objc_msgSend)(defaults, sel_registerName("volatileDomainForName:"),
+                                                    (id)CFSTR("NSArgumentDomain"));
+    CFMutableDictionaryRef domain =
+        current ? CFDictionaryCreateMutableCopy(kCFAllocatorDefault, 0, (CFDictionaryRef)current)
+                : CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                            &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(domain, CFSTR("ApplePressAndHoldEnabled"), kCFBooleanFalse);
+    ((void (*)(id, SEL, id, id))objc_msgSend)(defaults, sel_registerName("setVolatileDomain:forName:"),
+                                             (id)domain, (id)CFSTR("NSArgumentDomain"));
+    CFRelease(domain);
+  } else {
+    CFPreferencesSetAppValue(CFSTR("ApplePressAndHoldEnabled"), kCFBooleanFalse,
+                             kCFPreferencesCurrentApplication);
+    CFPreferencesAppSynchronize(kCFPreferencesCurrentApplication);
+  }
 #endif
