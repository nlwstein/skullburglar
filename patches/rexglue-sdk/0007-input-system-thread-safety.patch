@@ -63,6 +64,10 @@ class InputSystem : public system::IInputSystem {
 
   // Ordered by ordinal. Ordinals are never recycled, so unplugging pad one
   // does not renumber pad two.
+  // Guest code polls input from several threads at once (UE3 does during level loads), and every
+  // entry point re-enumerates devices_ / device_owners_; unsynchronized, a reader could see a
+  // half-rebuilt list and call through a stale driver pointer. Recursive: entry points nest.
+  std::recursive_mutex mutex_;
   std::vector<DeviceInfo> devices_;
   std::vector<InputDriver*> device_owners_;
 };
