+void DeferredCommandBuffer::ShrinkRenderArea() {
+  size_t begin = pass_begin_offset_;
+  pass_begin_offset_ = SIZE_MAX;
+  if (begin == SIZE_MAX || begin >= command_stream_.size() ||
+      !REXCVAR_GET(vulkan_shrink_render_area)) {
+    return;
+  }
+  uintmax_t* stream = command_stream_.data();
+  const auto& begin_header = *reinterpret_cast<const CommandHeader*>(stream + begin);
+  uintmax_t* begin_args = stream + begin + kCommandHeaderSizeElements;
+  VkRect2D* render_area;
+  if (begin_header.command == Command::kVkBeginRendering) {
+    auto& args = *reinterpret_cast<ArgsVkBeginRendering*>(begin_args);
+    // An MSAA resolve covers the render area - keep resolving everything.
+    const auto* attachments = reinterpret_cast<const VkRenderingAttachmentInfo*>(
+        reinterpret_cast<const uint8_t*>(begin_args) +
+        rex::align(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo)));
+    uint32_t attachment_count = args.color_attachment_count + uint32_t(args.has_depth_attachment) +
+                                uint32_t(args.has_stencil_attachment);
+    for (uint32_t i = 0; i < attachment_count; ++i) {
+      // A clear load op and a resolve both cover the render area - keep it whole.
+      if (attachments[i].resolveMode != VK_RESOLVE_MODE_NONE ||
+          attachments[i].loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR) {
+        return;
+      }
+    }
+    render_area = &args.render_area;
+  } else if (begin_header.command == Command::kVkBeginRenderPass) {
+    render_area = &reinterpret_cast<ArgsVkBeginRenderPass*>(begin_args)->render_area;
+  } else {
+    return;
+  }
+  // Bounding box of everything the pass writes.
+  int64_t x0 = INT64_MAX, y0 = INT64_MAX, x1 = INT64_MIN, y1 = INT64_MIN;
+  auto add = [&](const VkRect2D& r) {
+    x0 = std::min<int64_t>(x0, r.offset.x);
+    y0 = std::min<int64_t>(y0, r.offset.y);
+    x1 = std::max<int64_t>(x1, int64_t(r.offset.x) + r.extent.width);
+    y1 = std::max<int64_t>(y1, int64_t(r.offset.y) + r.extent.height);
+  };
+  VkRect2D scissor = pass_begin_scissor_;
+  bool scissor_valid = pass_begin_scissor_valid_;
+  size_t pos = begin;
+  while (pos < command_stream_.size()) {
+    const auto& header = *reinterpret_cast<const CommandHeader*>(stream + pos);
+    const uint8_t* args = reinterpret_cast<const uint8_t*>(stream + pos + kCommandHeaderSizeElements);
+    switch (header.command) {
+      case Command::kVkSetScissor: {
+        const auto& a = *reinterpret_cast<const ArgsVkSetScissor*>(args);
+        if (a.first_scissor == 0 && a.scissor_count) {
+          scissor = *reinterpret_cast<const VkRect2D*>(
+              args + rex::align(sizeof(ArgsVkSetScissor), alignof(VkRect2D)));
+          scissor_valid = true;
+        }
+      } break;
+      case Command::kVkDraw:
+      case Command::kVkDrawIndexed:
+        if (!scissor_valid) return;  // Unbounded draw - keep the full area.
+        add(scissor);
+        break;
+      case Command::kVkClearAttachments: {
+        const auto& a = *reinterpret_cast<const ArgsVkClearAttachments*>(args);
+        size_t rects_offset =
+            rex::align(rex::align(sizeof(ArgsVkClearAttachments), alignof(VkClearAttachment)) +
+                           sizeof(VkClearAttachment) * a.attachment_count,
+                       alignof(VkClearRect));
+        const auto* rects = reinterpret_cast<const VkClearRect*>(args + rects_offset);
+        for (uint32_t i = 0; i < a.rect_count; ++i) add(rects[i].rect);
+      } break;
+      default:
+        break;
+    }
+    pos += kCommandHeaderSizeElements + header.arguments_size_elements;
+  }
+  if (x0 >= x1 || y0 >= y1) {
+    return;  // Nothing written; leave as recorded.
+  }
+  int64_t ax0 = render_area->offset.x, ay0 = render_area->offset.y;
+  int64_t ax1 = ax0 + render_area->extent.width, ay1 = ay0 + render_area->extent.height;
+  x0 = std::max(x0, ax0);
+  y0 = std::max(y0, ay0);
+  x1 = std::min(x1, ax1);
+  y1 = std::min(y1, ay1);
+  if (x0 >= x1 || y0 >= y1) return;
+  render_area->offset.x = int32_t(x0);
+  render_area->offset.y = int32_t(y0);
+  render_area->extent.width = uint32_t(x1 - x0);
+  render_area->extent.height = uint32_t(y1 - y0);
+}
