+namespace {
+// Debug: REX_NAN_LOG=1 counts NaN/Inf values written to float constants (per constant slot,
+// 0-255 vertex, 256-511 pixel) and logs the worst slots every 5 s.
+void DebugNanScan(uint32_t first_reg, const uint32_t* values, uint32_t count) {
+  static const bool enabled = std::getenv("REX_NAN_LOG") != nullptr;
+  if (!enabled) return;
+  static std::mutex m;
+  static uint32_t hits[512] = {};
+  static uint64_t total = 0, writes = 0;
+  static auto t0 = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(m);
+  for (uint32_t i = 0; i < count; ++i) {
+    ++writes;
+    if ((values[i] & 0x7F800000u) == 0x7F800000u) {
+      uint32_t c = (first_reg + i - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
+      if (c < 512) ++hits[c];
+      ++total;
+    }
+  }
+  auto now = std::chrono::steady_clock::now();
+  if (std::chrono::duration<double>(now - t0).count() < 5.0) return;
+  t0 = now;
+  std::string top;
+  for (int n = 0; n < 8; ++n) {
+    uint32_t best = 0, bi = 0;
+    for (uint32_t c = 0; c < 512; ++c) if (hits[c] > best) { best = hits[c]; bi = c; }
+    if (!best) break;
+    top += fmt::format(" {}{}={}", bi < 256 ? "v" : "p", bi & 255, best);
+    hits[bi] = 0;
+  }
+  REXGPU_INFO("nan-scan: {} non-finite of {} const writes;{}", total, writes, top);
+  std::fill(std::begin(hits), std::end(hits), 0u);
+  total = writes = 0;
+}
+}  // namespace
