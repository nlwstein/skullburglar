+// B-111: one Windows startup sat 5 min between device creation and the swapchain with nothing logged. Warn about any
+// surface / swapchain step that takes over half a second, so the next stall says where it was.
+struct SlowStepLog {
+  explicit SlowStepLog(const char* what) : what_(what), start_(std::chrono::steady_clock::now()) {}
+  ~SlowStepLog() {
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start_)
+                        .count();
+    if (ms >= 500) REXLOG_WARN("VulkanPresenter: {} took {} ms", what_, ms);
+  }
+  const char* what_;
+  std::chrono::steady_clock::time_point start_;
+};
