+  // No handler claimed the fault. Returning would re-execute the faulting instruction forever
+  // (seen as an endless "Unhandled guest access violation" log loop), so report and abort -
+  // a SIGABRT handler can then print a backtrace that includes the faulting frames.
+  char message[192];
+  int message_length = snprintf(
+      message, sizeof(message),
+      "\n=== unhandled host signal %d at pc 0x%llx, fault address 0x%llx ===\n", signal_number,
+      static_cast<unsigned long long>(ex.pc()),
+      static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(signal_info->si_addr)));
+  if (message_length > 0) {
+    write(STDERR_FILENO, message, size_t(message_length));
+  }
+  abort();
