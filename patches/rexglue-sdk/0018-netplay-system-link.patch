+// System link over UDP (bots-recomp SDK patch 0010). Every instance has a slot (0..kMaxSlots-1,
+// one per process on a machine) and maps guest port P to host port P + PortOffset(slot), so
+// several instances can share one machine and the game's fixed ports (VDP 1000, listen 7777,
+// system link 14000, LAN beacon 14001) never need privileges. Datagrams carry a 4-byte prefix
+// naming the sender's slot, which lets the receiver translate the source back into the guest
+// view. Peers are addressed by synthetic "secure" IN_ADDRs (XNetXnAddrToInAddr) that stand for
+// (host IP, slot); a guest broadcast goes to that port in every slot.
+namespace netplay {
+constexpr uint32_t kMaxSlots = 8;
+// Values are host order. LocalIp() is the address peers reach this instance at.
+uint32_t Slot();
+uint32_t LocalIp();
+uint16_t PortOffset(uint32_t slot);
+bool Trace();
+// XNADDR (36 bytes, guest layout) of the instance at (ip, slot), and back.
+void BuildXnAddr(uint32_t ip, uint32_t slot, uint8_t* xnaddr);
+void ParseXnAddr(const uint8_t* xnaddr, uint32_t* ip, uint32_t* slot);
+// Synthetic peer address for (ip, slot), created on first use; and the reverse lookup.
+uint32_t SecureAddr(uint32_t ip, uint32_t slot);
+bool LookupSecureAddr(uint32_t secure, uint32_t* ip, uint32_t* slot);
+void RandomBytes(void* out, size_t len);
+}  // namespace netplay
+
 }  // namespace rex::system
