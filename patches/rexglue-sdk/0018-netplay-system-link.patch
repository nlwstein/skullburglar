+static UserProfile* LocalUser(uint32_t user_index, const char* caller = nullptr) {
+  auto* user = REX_KERNEL_STATE()->user_profile(user_index);
+  if (caller && user_index && user_index < 4) {
+    static std::mutex mutex;
+    static std::set<std::string> seen;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (seen.insert(fmt::format("{}/{}/{}", caller, user_index, user != nullptr)).second) {
+      REXKRNL_INFO("{}: user {} ({})", caller, user_index, user ? user->name() : "not signed in");
+    }
+  }
+  return user;
+}
+
+static UserProfile* LocalUserByXuid(uint64_t xuid) {
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (auto* user = LocalUser(i); user && user->xuid() == xuid) return user;
+  }
+  return nullptr;
+}
