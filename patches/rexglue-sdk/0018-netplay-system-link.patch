+// Network events are not tracked; signal the event so a waiter polls the (non-blocking) socket.
+u32 NetDll_WSAEventSelect_entry(u32 caller, u32 socket_handle, u32 event_handle, u32 events) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(0x2736);
+    return -1;
+  }
+  uint32_t nonblocking = rex::byte_swap(uint32_t(events ? 1 : 0));
+  socket->IOControl(0x8004667E, reinterpret_cast<uint8_t*>(&nonblocking));
+  if (netplay::Trace()) {
+    REXLOG_INFO("netplay: socket {:X} WSAEventSelect event {:X} mask {:X}", uint32_t(socket_handle),
+                uint32_t(event_handle), uint32_t(events));
+  }
+  if (event_handle && events) {
+    auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle);
+    if (ev) ev->Set(0, false);
+  }
   return 0;
 }
 
