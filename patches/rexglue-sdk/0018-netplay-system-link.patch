+// System link keys. Real XNet negotiates a security association per key; here the key only
+// needs to round-trip (XSessionCreate hands it out, the joining title registers it).
+std::mutex xnet_keys_mutex;
+std::vector<std::vector<uint8_t>> xnet_keys;
+
+// XNKID first byte: high nibble 0 = system link, 0x8 = online peer, 0xC = online server.
+u32 NetDll_XNetCreateKey_entry(u32 caller, mapped_void xnkid, mapped_void xnkey) {
+  netplay::RandomBytes(xnkid, 8);
+  static_cast<uint8_t*>(xnkid.host_address())[0] &= 0x0F;
+  netplay::RandomBytes(xnkey, 16);
+  return 0;
+}
+
+u32 NetDll_XNetRegisterKey_entry(u32 caller, mapped_void xnkid, mapped_void xnkey) {
+  auto* id = static_cast<const uint8_t*>(xnkid.host_address());
+  std::lock_guard<std::mutex> lock(xnet_keys_mutex);
+  for (auto& k : xnet_keys) {
+    if (std::memcmp(k.data(), id, 8) == 0) return 0;
+  }
+  xnet_keys.emplace_back(id, id + 8);
+  return 0;
+}
+
+u32 NetDll_XNetUnregisterKey_entry(u32 caller, mapped_void xnkid) {
+  auto* id = static_cast<const uint8_t*>(xnkid.host_address());
+  std::lock_guard<std::mutex> lock(xnet_keys_mutex);
+  xnet_keys.erase(std::remove_if(xnet_keys.begin(), xnet_keys.end(),
+                                 [&](auto& k) { return std::memcmp(k.data(), id, 8) == 0; }),
+                  xnet_keys.end());
+  return 0;
 }
 
