+uint32_t DetectLocalIp() {
+  // A connected UDP socket sends nothing; getsockname reports the interface the route uses.
+  uint32_t ip = 0;
+  auto fd = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (fd < 0) return 0x7F000001;
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(9);
+  to.sin_addr.s_addr = htonl(0x0AFFFFFF);  // 10.255.255.255
+  if (::connect(fd, reinterpret_cast<sockaddr*>(&to), sizeof(to)) == 0) {
+    sockaddr_in me{};
+    socklen_t len = sizeof(me);
+    if (::getsockname(fd, reinterpret_cast<sockaddr*>(&me), &len) == 0) ip = ntohl(me.sin_addr.s_addr);
+  }
+  rex::net::socket_close(fd);
+  return ip ? ip : 0x7F000001;
+}
+
+// The broadcast address of the interface that has `ip`, or 255.255.255.255 if there's none.
+uint32_t DetectBroadcast(uint32_t ip) {
+  uint32_t mask = 0;
+#if REX_PLATFORM_WIN32
+  auto fd = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (fd != INVALID_SOCKET) {
+    INTERFACE_INFO list[32];
+    DWORD bytes = 0;
+    if (WSAIoctl(fd, SIO_GET_INTERFACE_LIST, nullptr, 0, list, sizeof(list), &bytes, nullptr, nullptr) == 0) {
+      for (DWORD i = 0; i < bytes / sizeof(INTERFACE_INFO); ++i) {
+        if (ntohl(list[i].iiAddress.AddressIn.sin_addr.s_addr) == ip) {
+          mask = ntohl(list[i].iiNetmask.AddressIn.sin_addr.s_addr);
+          break;
+        }
+      }
+    }
+    rex::net::socket_close(fd);
+  }
+#else
+  ifaddrs* list = nullptr;
+  if (getifaddrs(&list) == 0) {
+    for (ifaddrs* a = list; a; a = a->ifa_next) {
+      if (a->ifa_addr && a->ifa_netmask && a->ifa_addr->sa_family == AF_INET && (a->ifa_flags & IFF_BROADCAST) &&
+          ntohl(reinterpret_cast<sockaddr_in*>(a->ifa_addr)->sin_addr.s_addr) == ip) {
+        mask = ntohl(reinterpret_cast<sockaddr_in*>(a->ifa_netmask)->sin_addr.s_addr);
+        break;
+      }
+    }
+    freeifaddrs(list);
+  }
+#endif
+  // /31 and /32 have no broadcast address; loopback isn't a LAN.
+  if ((ip >> 24) == 127 || mask == 0 || ~mask < 3) return 0xFFFFFFFF;
+  return (ip & mask) | ~mask;
+}
