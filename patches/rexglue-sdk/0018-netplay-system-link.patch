+void Init() {
+  std::call_once(init_once, [] {
+#if REX_PLATFORM_WIN32
+    WSADATA wsa;
+    WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+    int want = REXCVAR_GET(netplay_slot);
+    slot_ = want >= 0 ? std::min<uint32_t>(want, kMaxSlots - 1) : kMaxSlots;
+    // Hold a lock port so the next instance on this machine picks another slot.
+    for (uint32_t s = want >= 0 ? slot_ : 0; s < kMaxSlots; ++s) {
+      auto fd = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+      sockaddr_in a{};
+      a.sin_family = AF_INET;
+      a.sin_port = htons(kSlotLockPort + s);
+      a.sin_addr.s_addr = htonl(INADDR_ANY);
+      if (::bind(fd, reinterpret_cast<sockaddr*>(&a), sizeof(a)) == 0) {
+        if (want < 0) slot_ = s;
+        break;  // keep fd open for the life of the process
+      }
+      rex::net::socket_close(fd);
+      if (want >= 0) {
+        REXLOG_WARN("netplay: slot {} is already used by another instance on this machine", s);
+        break;
+      }
+    }
+    if (slot_ >= kMaxSlots) {
+      REXLOG_WARN("netplay: no free slot (8 instances running?), using 7");
+      slot_ = kMaxSlots - 1;
+    }
+    std::string addr = REXCVAR_GET(netplay_address);
+    local_ip_ = addr.empty() ? DetectLocalIp() : ParseIp(addr);
+    if (!local_ip_) local_ip_ = 0x7F000001;
+    broadcast_ip_ = DetectBroadcast(local_ip_);
+    std::string list = REXCVAR_GET(netplay_peers);
+    for (size_t pos = 0; pos < list.size();) {
+      size_t end = list.find(',', pos);
+      std::string item = list.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+      item.erase(0, item.find_first_not_of(' '));
+      item.erase(item.find_last_not_of(' ') + 1);
+      if (uint32_t ip = ParseIp(item)) extra_peers_.push_back(ip);
+      pos = end == std::string::npos ? list.size() : end + 1;
+    }
+    REXLOG_INFO("netplay: slot {} at {}.{}.{}.{} (broadcast {}.{}.{}.{}), guest port P = host port P+{}", slot_,
+                local_ip_ >> 24, (local_ip_ >> 16) & 0xFF, (local_ip_ >> 8) & 0xFF, local_ip_ & 0xFF,
+                broadcast_ip_ >> 24, (broadcast_ip_ >> 16) & 0xFF, (broadcast_ip_ >> 8) & 0xFF,
+                broadcast_ip_ & 0xFF, PortOffset(slot_));
+  });
