+// Completes an overlapped operation immediately: Internal = status, InternalHigh = bytes.
+void CompleteOverlapped(XWSAOVERLAPPED* overlapped, uint32_t bytes) {
+  overlapped->internal = 0;
+  overlapped->internal_high = bytes;
+  if (overlapped->event_handle) {
+    auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(overlapped->event_handle);
+    if (ev) ev->Set(0, false);
+  }
+}
+
+void ScatterBuffers(XWSABUF* buffers, uint32_t num_buffers, const uint8_t* data, uint32_t len) {
+  for (uint32_t i = 0; i < num_buffers && len; i++) {
+    uint32_t n = std::min<uint32_t>(len, buffers[i].len);
+    std::memcpy(REX_KERNEL_MEMORY()->TranslateVirtual(buffers[i].buf_ptr), data, n);
+    data += n;
+    len -= n;
+  }
+}
+
+int RecvFlags(bool overlapped) {
+#if REX_PLATFORM_WIN32
+  return 0;
+#else
+  // Overlapped receives complete immediately or fail with WOULDBLOCK; never park the thread.
+  return overlapped ? MSG_DONTWAIT : 0;
+#endif
+}
+
+u32 NetDll_WSARecvFrom_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XWSABUF> buffers,
+                             u32 num_buffers, mapped_u32 num_bytes_recv, mapped_u32 flags_ptr,
+                             ppc_ptr_t<XSOCKADDR_IN> from_ptr, mapped_u32 fromlen_ptr,
+                             ppc_ptr_t<XWSAOVERLAPPED> overlapped, mapped_void completion_routine) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    // WSAENOTSOCK
+    XThread::SetLastError(0x2736);
+    return -1;
+  }
+
+  uint32_t capacity = 0;
+  for (uint32_t i = 0; i < num_buffers; i++) capacity += buffers[i].len;
+  std::vector<uint8_t> data(capacity);
+  N_XSOCKADDR_IN native_from;
+  uint32_t native_fromlen = sizeof(XSOCKADDR_IN);
+  int ret = socket->RecvFrom(data.data(), capacity, RecvFlags(bool(overlapped)), &native_from,
+                             &native_fromlen);
+  if (ret < 0) {
+    XThread::SetLastError(XSocket::LastWsaError());
+    return -1;
+  }
+  ScatterBuffers(buffers, num_buffers, data.data(), uint32_t(ret));
+  if (from_ptr) {
+    from_ptr->sin_family = native_from.sin_family;
+    from_ptr->sin_port = native_from.sin_port;
+    from_ptr->sin_addr = native_from.sin_addr;
+    std::memset(from_ptr->x_sin_zero, 0, sizeof(from_ptr->x_sin_zero));
+  }
+  if (fromlen_ptr) *fromlen_ptr = native_fromlen;
+  if (flags_ptr) *flags_ptr = 0;
+  if (num_bytes_recv) *num_bytes_recv = uint32_t(ret);
+  if (overlapped) CompleteOverlapped(overlapped, uint32_t(ret));
+  return 0;
+}
+
+u32 NetDll_WSARecv_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XWSABUF> buffers,
+                         u32 num_buffers, mapped_u32 num_bytes_recv, mapped_u32 flags_ptr,
+                         ppc_ptr_t<XWSAOVERLAPPED> overlapped, mapped_void completion_routine) {
+  return NetDll_WSARecvFrom_entry(caller, socket_handle, buffers, num_buffers, num_bytes_recv,
+                                  flags_ptr, ppc_ptr_t<XSOCKADDR_IN>(), mapped_u32(), overlapped,
+                                  completion_routine);
+}
 
