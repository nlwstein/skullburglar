+// XNADDR: ina(4) inaOnline(4) wPortOnline(2) abEnet(6) abOnline(20). abEnet is a locally
+// administered MAC that encodes (ip, slot); abOnline starts with "RXNP" + slot so ParseXnAddr
+// can tell our addresses from a zeroed one.
+void BuildXnAddr(uint32_t ip, uint32_t slot, uint8_t* x) {
+  std::memset(x, 0, 36);
+  uint32_t be_ip = htonl(ip);
+  std::memcpy(x + 0, &be_ip, 4);
+  x[8] = 0;
+  x[9] = uint8_t(slot);
+  x[10] = 0x02;
+  x[11] = uint8_t(0x50 | slot);
+  std::memcpy(x + 12, &be_ip, 4);
+  std::memcpy(x + 16, "RXNP", 4);
+  x[20] = uint8_t(slot);
+}
+
+void ParseXnAddr(const uint8_t* x, uint32_t* ip, uint32_t* slot) {
+  uint32_t be_ip;
+  std::memcpy(&be_ip, x + 0, 4);
+  *ip = ntohl(be_ip);
+  *slot = std::memcmp(x + 16, "RXNP", 4) == 0 ? std::min<uint32_t>(x[20], kMaxSlots - 1) : 0;
+}
+
+uint32_t SecureAddr(uint32_t ip, uint32_t slot) {
+  ip = Canonical(ip);
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  for (size_t i = 0; i < peers_.size(); ++i) {
+    if (peers_[i].ip == ip && peers_[i].slot == slot) return kSecureBase + 1 + uint32_t(i);
+  }
+  if (peers_.size() >= 0xFE) return ip;  // table full: fall back to the plain address
+  peers_.push_back({ip, slot});
+  uint32_t secure = kSecureBase + uint32_t(peers_.size());
+  if (Trace()) {
+    REXLOG_INFO("netplay: peer {} slot {} is {}", IpString(ip), slot, IpString(secure));
+  }
+  return secure;
+}
+
+bool LookupSecureAddr(uint32_t secure, uint32_t* ip, uint32_t* slot) {
+  if ((secure & 0xFFFFFF00) != kSecureBase) return false;
+  uint32_t n = (secure & 0xFF) - 1;
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  if (n >= peers_.size()) return false;
+  *ip = peers_[n].ip;
+  *slot = peers_[n].slot;
+  return true;
+}
+
+// A peer the guest addressed by a plain IP (console "open <ip>") must see replies from that same
+// IP, not a synthetic one: UE3 drops packets whose source is not the connection's address.
+void NotePlainPeer(uint32_t ip) {
+  uint32_t canonical = Canonical(ip);
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  for (auto& p : plain_peers_) {
+    if (p.first == canonical) {
+      p.second = ip;
+      return;
+    }
+  }
+  plain_peers_.push_back({canonical, ip});
+}
+
+bool PlainPeer(uint32_t canonical, uint32_t* ip) {
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  for (auto& p : plain_peers_) {
+    if (p.first == canonical) {
+      *ip = p.second;
+      return true;
+    }
+  }
+  return false;
+}
