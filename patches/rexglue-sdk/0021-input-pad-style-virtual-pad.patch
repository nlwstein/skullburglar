+// LastActivePadStyle(): written on the thread that drains events, read anywhere.
+std::atomic<uint32_t> last_pad_style{uint32_t(PadStyle::kXbox)};
+
+PadStyle StyleOf(SDL_Gamepad* gamepad) {
+  switch (SDL_GetGamepadType(gamepad)) {
+    case SDL_GAMEPAD_TYPE_PS4:
+      return PadStyle::kPlayStation4;
+    case SDL_GAMEPAD_TYPE_PS5:
+      return PadStyle::kPlayStation5;
+    default:
+      return PadStyle::kXbox;
+  }
+}
+
+// REX_VIRTUAL_PAD=ps4|ps5|xbox[;<secs>:<button>...] (testing): attach an SDL virtual gamepad with that pad's USB
+// vendor/product ids, which SDL types the same way as the real pad, and press each named button (SDL's names: a, b,
+// x, y, back, start, leftshoulder, dpup, ...) for 150 ms that many seconds after attaching. Needs SDL_INIT_GAMEPAD.
+void AttachVirtualPad() {
+  const char* spec = std::getenv("REX_VIRTUAL_PAD");
+  if (!spec || !*spec) return;
+  // A test run is rarely the focused window, and SDL drops joystick events then.
+  SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+  static constexpr struct {
+    const char* kind;
+    uint16_t vendor, product;
+    const char* name;
+  } kPads[] = {{"ps4", 0x054C, 0x09CC, "Virtual DualShock 4"},
+               {"ps5", 0x054C, 0x0CE6, "Virtual DualSense"},
+               {"xbox", 0x045E, 0x028E, "Virtual Xbox 360 Controller"}};
+  const std::string text(spec);
+  const std::string kind = text.substr(0, text.find(';'));
+  const auto* pad = std::find_if(std::begin(kPads), std::end(kPads), [&](const auto& p) { return kind == p.kind; });
+  if (pad == std::end(kPads)) {
+    REXLOG_WARN("REX_VIRTUAL_PAD: unknown pad '{}' (ps4, ps5 or xbox)", kind);
+    return;
+  }
+  SDL_VirtualJoystickDesc desc;
+  SDL_INIT_INTERFACE(&desc);
+  desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+  desc.vendor_id = pad->vendor;
+  desc.product_id = pad->product;
+  desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+  desc.nbuttons = SDL_GAMEPAD_BUTTON_DPAD_RIGHT + 1;  // with no button_mask, SDL maps button i to SDL_GamepadButton i
+  desc.name = pad->name;
+  const SDL_JoystickID id = SDL_AttachVirtualJoystick(&desc);
+  SDL_Joystick* joystick = id ? SDL_OpenJoystick(id) : nullptr;
+  if (!joystick) {
+    REXLOG_ERROR("REX_VIRTUAL_PAD: attach failed: {}", SDL_GetError());
+    return;
+  }
+  struct Press {
+    std::chrono::milliseconds at;
+    SDL_GamepadButton button;
+  };
+  std::vector<Press> presses;
+  for (size_t at = text.find(';'); at != std::string::npos; at = text.find(';', at + 1)) {
+    const std::string item = text.substr(at + 1, text.find(';', at + 1) - at - 1);
+    const size_t colon = item.find(':');
+    const SDL_GamepadButton button =
+        colon == std::string::npos ? SDL_GAMEPAD_BUTTON_INVALID : SDL_GetGamepadButtonFromString(item.c_str() + colon + 1);
+    if (button == SDL_GAMEPAD_BUTTON_INVALID || button >= desc.nbuttons) {
+      REXLOG_WARN("REX_VIRTUAL_PAD: skipped '{}' (want <secs>:<button>)", item);
+      continue;
+    }
+    presses.push_back({std::chrono::milliseconds(int64_t(std::atof(item.c_str()) * 1000)), button});
+  }
+  REXLOG_INFO("REX_VIRTUAL_PAD: attached \"{}\" ({:04X}:{:04X}), {} presses", pad->name, pad->vendor, pad->product,
+              presses.size());
+  if (presses.empty()) return;
+  // The joystick stays open for the process: a test hook, not worth a shutdown handshake.
+  std::thread([joystick, presses] {
+    const auto start = std::chrono::steady_clock::now();
+    for (const Press& press : presses) {
+      std::this_thread::sleep_until(start + press.at);
+      REXLOG_INFO("REX_VIRTUAL_PAD: {}", SDL_GetGamepadStringForButton(press.button));
+      SDL_SetJoystickVirtualButton(joystick, press.button, true);
+      std::this_thread::sleep_for(std::chrono::milliseconds(150));
+      SDL_SetJoystickVirtualButton(joystick, press.button, false);
+    }
+  }).detach();
+}
