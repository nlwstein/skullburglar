+// std::filesystem::exists(path) throws for errors other than "not found", for example a path over MAX_PATH on
+// Windows (ERROR_FILENAME_EXCED_RANGE) in a deep user data root. A kernel call must report that, not throw.
+bool PathExists(const std::filesystem::path& path) {
+  std::error_code ec;
+  return std::filesystem::exists(path, ec);
