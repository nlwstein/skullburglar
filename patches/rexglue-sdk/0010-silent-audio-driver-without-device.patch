 namespace rex::audio::sdl {
 
+namespace {
+
+// Used when no output device can be opened (headless box, no sound card, unplugged headset). A real
+// console never fails XAudioRegisterRenderDriverClient, and a game handed the error keeps going with a
+// null driver handle (50 Cent BotS reads guest 0x3C a second later). This driver accepts the client and
+// consumes each submitted frame at the device rate, so the guest's audio thread stays paced as usual.
+class SilentAudioDriver : public AudioDriver {
+ public:
+  SilentAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore), worker_([this] { Run(); }) {}
+  ~SilentAudioDriver() override {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    cv_.notify_all();
+    worker_.join();
+  }
+
+  void SubmitFrame(uint32_t /*frame_ptr*/) override {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++pending_;
+    }
+    cv_.notify_all();
+  }
+
+ private:
+  // 256 samples per channel at 48 kHz.
+  static constexpr auto kFramePeriod = std::chrono::microseconds(256 * 1000000 / 48000);
+
+  void Run() {
+    auto next = std::chrono::steady_clock::now();
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (true) {
+      cv_.wait(lock, [this] { return stop_ || pending_ > 0; });
+      if (stop_) return;
+      // Like a device that went idle: don't let an empty queue bank time.
+      next = std::max(next + kFramePeriod, std::chrono::steady_clock::now());
+      if (cv_.wait_until(lock, next, [this] { return stop_; })) return;
+      --pending_;
+      lock.unlock();
+      semaphore_->Release(1, nullptr);
+      lock.lock();
+    }
+  }
+
+  rex::thread::Semaphore* semaphore_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  uint32_t pending_ = 0;
+  bool stop_ = false;
+  std::thread worker_;
+};
+
+}  // namespace
